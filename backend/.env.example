# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit it.

# Django
SECRET_KEY=generate-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (True = local SQLite; False = Postgres below)
USE_SQLITE=True
DB_NAME=grana_ai_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (cache + Celery broker)
REDIS_URL=redis://127.0.0.1:6379/0

# Pluggy (Open Banking) — from https://dashboard.pluggy.ai
# NOTE: these replace the old PLUGGY_API_KEY; API keys are minted at runtime via POST /auth
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# OpenAI (transaction categorization) — optional; keyword fallback is used if unset
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
